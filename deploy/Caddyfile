(public_site) {
	encode zstd gzip

	@legacy_start path /start
	header @legacy_start X-Robots-Tag "noindex, follow"
	redir @legacy_start / temporary

	@leadership_transition_alias path /probleme/neu-in-fuehrung
	redir @leadership_transition_alias /probleme/leadership-transition permanent

	@site_metadata path /robots.txt /sitemap.xml /llms.txt /4eba2fbccd4fbe055b49e6d9d41c4e00.txt
	handle @site_metadata {
		root * /srv/cleonhardt-static/portfolio
		file_server
	}

	@workspace_portal path /workspace /workspace/* /beta /beta/*
	handle @workspace_portal {
		header {
			-Server
			Cache-Control "no-store"
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
			Referrer-Policy "no-referrer"
			Permissions-Policy "camera=(), geolocation=(), microphone=()"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			X-Robots-Tag "noindex, nofollow, noarchive"
		}
		reverse_proxy beta-portal:3000
	}

	@portfolio_assets path /assets/*
	header @portfolio_assets {
		Cache-Control "public, max-age=31536000, immutable"
		-Pragma
		-Expires
	}

	@portfolio_routes path / /projekte /projekte/* /ueber-mich /kontakt /impressum /datenschutz /assets/*
	handle @portfolio_routes {
		root * /srv/cleonhardt-static/portfolio
		try_files {path} {path}/index.html
		file_server
	}

	@legacy_chos path /chos /chos-selbstcheck
	redir @legacy_chos /projekte#chos temporary

	@legacy_consulting path /probleme /probleme/* /leistungen /angebot-anfragen /clarity-session /decision-review /product-organisation-diagnostic /ai-operating-model-assessment /ai-enabled-workflow-sprint /executive-sparring /praxisfaelle /insights /insights/* /leadership-product-sparring /leadership-product-sparring/* /quick-diagnostic /quick-diagnostic/* /workshops /workshops/* /chos-transformation-program /chos-transformation-program/*
	redir @legacy_consulting /projekte temporary

	handle {
		header Cache-Control "no-store"
		root * /srv/cleonhardt-static/portfolio
		rewrite * /404.html
		file_server {
			status 404
		}
	}

	@non_workspace not path /workspace /workspace/* /beta /beta/*
	header @non_workspace {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}
}

http://191.218.164.219 {
	import public_site
}

cleonhardt.de {
	import public_site
}

cms.cleonhardt.de {
	encode zstd gzip
	log

	header {
		-Server
		Cache-Control "no-store"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "frame-ancestors 'self'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}

	route {
		basic_auth {
			christian {$CMS_BASIC_AUTH_HASH}
		}

		@cms_root path /
		redir @cms_root /magnoliaAuthor/.magnolia/admincentral 302

		reverse_proxy magnolia-author:8080 {
			header_up -Authorization
			header_down X-Frame-Options "SAMEORIGIN"
			header_down Content-Security-Policy "frame-ancestors 'self'"
		}
	}
}

www.cleonhardt.de {
	redir https://cleonhardt.de{uri} permanent
}
